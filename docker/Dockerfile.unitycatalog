FROM eclipse-temurin:17-jdk-jammy

WORKDIR /opt/unitycatalog
RUN apt-get update && apt-get install -y git curl

# Clone the Unity Catalog repository
RUN git clone https://github.com/unitycatalog/unitycatalog.git .

# Build the project
RUN build/sbt clean package

# Configure server to bind to 0.0.0.0 so Docker can map the port
RUN mkdir -p etc/conf && \
    echo "server.env=production" > etc/conf/server.properties && \
    echo "server.host=0.0.0.0" >> etc/conf/server.properties

EXPOSE 8080

CMD ["bin/start-uc-server"]
