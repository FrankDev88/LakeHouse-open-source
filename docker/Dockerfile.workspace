FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements.workspace.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Pre-install DuckDB extensions for S3 and DuckLake
RUN python -c "import duckdb; conn = duckdb.connect(); conn.execute('INSTALL httpfs; INSTALL aws; INSTALL ducklake;'); conn.close()"

ENV PYTHONPATH=/workspace
ENV DBT_PROJECT_DIR=/workspace/dbt_project
ENV DBT_PROFILES_DIR=/workspace/dbt_project
