FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements.workspace.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Pre-install DuckDB extensions for S3 and Delta
RUN python -c "import duckdb; conn = duckdb.connect(); conn.execute('INSTALL httpfs; INSTALL delta; INSTALL aws;'); conn.close()"

ENV PYTHONPATH=/workspace
